############
# Scorelens Online – Self-Hosting. ./setup.sh erzeugt diese Datei mit zufälligen Geheimnissen.
# Alle Werte unten sind Platzhalter und MÜSSEN vor dem ersten Start ersetzt werden.
############

# Postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=CHANGE-ME-postgres-password

# JWT (HS256): Secret ≥ 32 Zeichen; ANON_KEY / SERVICE_ROLE_KEY sind damit signierte JWTs (role anon / service_role)
JWT_SECRET=CHANGE-ME-jwt-secret-with-at-least-32-characters
JWT_EXPIRY=3600
ANON_KEY=CHANGE-ME
SERVICE_ROLE_KEY=CHANGE-ME

# Realtime / Studio
SECRET_KEY_BASE=CHANGE-ME-64-characters
REALTIME_DB_ENC_KEY=CHANGE-ME-16chr
PG_META_CRYPTO_KEY=CHANGE-ME-32-characters

# Öffentliche URL des Gateways – genau das trägt man in der App als Supabase-URL ein
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# ":8000" = nur HTTP auf Port 8000; Domainname (z. B. darts.example.com) = automatisches HTTPS
CADDY_SITE_ADDRESS=:8000
GATEWAY_HTTP_PORT=8000
STUDIO_PORT=3000

# Auth
SITE_URL=scorelens://auth/callback
ADDITIONAL_REDIRECT_URLS=scorelens://auth/callback
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Ohne Mailserver: E-Mail-Adressen sofort bestätigen
ENABLE_EMAIL_AUTOCONFIRM=true
# Gast-Login in der App ("Als Gast spielen")
ENABLE_ANONYMOUS_USERS=true

# SMTP (nur nötig, wenn ENABLE_EMAIL_AUTOCONFIRM=false oder Passwort-Reset gewünscht)
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Scorelens

# OAuth-Anbieter (Supabase OAuth). Beim Anbieter als Redirect-URL eintragen: ${API_EXTERNAL_URL}/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_SECRET=
