# API-Gateway für das selbst gehostete Supabase von Scorelens.
# CADDY_SITE_ADDRESS = ":8000" (nur HTTP) oder ein Domainname (dann automatisch HTTPS über Let's Encrypt, Ports 80/443).
{$CADDY_SITE_ADDRESS::8000} {
	encode gzip

	# Auth (GoTrue): /auth/v1/* → auth:9999/*
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	# REST (PostgREST): /rest/v1/* → rest:3000/*
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	# Realtime (WebSocket): /realtime/v1/websocket → realtime:4000/socket/websocket
	handle_path /realtime/v1/* {
		rewrite * /socket{uri}
		reverse_proxy realtime-dev.supabase-realtime:4000 {
			header_up Host realtime-dev.supabase-realtime
		}
	}

	# Freundes-Link (gleiche Seite wie supabase/functions/friend): öffnet die App per intent://
	@friend path_regexp friend ^/functions/v1/friend/([0-9a-fA-F-]{36})$
	handle @friend {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Scorelens – Freund hinzufügen</title>
<p style="font-family:sans-serif;padding:24px">Scorelens wird geöffnet …<br><br>Passiert nichts? <a href="scorelens://friend/{re.friend.1}">App öffnen</a> (Scorelens muss installiert sein).</p>
<script>location.replace("intent://friend/{re.friend.1}#Intent;scheme=scorelens;package=com.freedarts.scorer;end")</script>` 200
	}

	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "Scorelens Online – Supabase (self-hosted). Endpunkte: /auth/v1, /rest/v1, /realtime/v1" 200
	}
}
